#!/bin/sh
set -eu
umask 077
directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd); compose_file=$directory/compose.yaml; env_file=$directory/.env; helper=$directory/db-unpause-watchdog
die(){ printf '%s\n' "db recovery rejected: $*" >&2; exit 1; }
if docker info >/dev/null 2>&1; then
  docker_access_mode=direct
  docker_command(){ docker "$@"; }
elif command -v sudo >/dev/null 2>&1 && sudo -n -k docker info >/dev/null 2>&1; then
  docker_access_mode=sudo-n
  docker_command(){ sudo -n docker "$@"; }
  # Prove the selected non-interactive grant also works outside our SSH session.
  setsid sudo -n -k docker info </dev/null >/dev/null 2>&1 || die "detached sudo -n Docker access unavailable"
else die "Docker unavailable through direct access or sudo -n"; fi
compose(){ docker_command compose --project-directory "$directory" --env-file "$env_file" -f "$compose_file" "$@"; }
app_node(){ compose exec -T app node "$@"; }
valid_run(){ case "$1" in ''|*[!a-z0-9-]*) die "invalid run ID";; esac; [ "${#1}" -le 64 ] || die "invalid run ID"; }
identity(){ id=$(compose ps -q db); [ "${#id}" -eq 64 ] || die "DB identity is not one immutable 64-hex ID"; case "$id" in *[!0-9a-f]*) die "unsafe DB ID";; esac; [ "$(docker_command inspect --format '{{index .Config.Labels "com.docker.compose.project"}}/{{index .Config.Labels "com.docker.compose.service"}}/{{.Name}}' "$id")" = 'modern-field-test-v1/db//modern-field-test-v1-db-1' ] || die "DB identity labels/name mismatch"; printf %s "$id"; }
app_identity(){ app_id=$(compose ps -q app); [ "${#app_id}" -eq 64 ] || die "app identity is not one immutable 64-hex ID"; case "$app_id" in *[!0-9a-f]*) die "unsafe app ID";; esac; [ "$(docker_command inspect --format '{{index .Config.Labels "com.docker.compose.project"}}/{{index .Config.Labels "com.docker.compose.service"}}/{{.Name}}' "$app_id")" = 'modern-field-test-v1/app//modern-field-test-v1-app-1' ] || die "app identity labels/name mismatch"; printf %s "$app_id"; }
bounded_verify(){ pinned_app_id=$1; if [ "$docker_access_mode" = direct ]; then timeout --foreground --signal=KILL 5 docker exec "$pinned_app_id" node deploy/field-test/data-operation.js verify; else sudo -n timeout --foreground --signal=KILL 5 docker exec "$pinned_app_id" node deploy/field-test/data-operation.js verify; fi; }
prove_bounded_verify(){ if [ "$docker_access_mode" = direct ]; then timeout --foreground --signal=KILL 2 true; else sudo -n timeout --foreground --signal=KILL 2 true; fi; }
require_verify_exec_gone(){ pinned_app_id=$1; attempt=0; while :; do processes=$(docker_command top "$pinned_app_id" -eo args) || die "cannot inspect bounded verify app exec processes"; case "$processes" in *'node deploy/field-test/data-operation.js verify'*) attempt=$((attempt+1)); [ "$attempt" -lt 5 ] || die "bounded verify left a live app exec process"; sleep 1;; *) return;; esac; done; }
health(){ [ "$(docker_command inspect --format '{{.State.Status}}/{{.State.Paused}}/{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$1")" = 'running/false/healthy' ] || die "DB not running, unpaused, healthy"; }
wait_healthy_exact(){ pinned_db_id=$1; attempt=0; while [ "$attempt" -lt 12 ]; do kill -0 "$watchdog_pid" || die "watchdog ended before DB readiness"; [ "$(identity)" = "$pinned_db_id" ] || die "DB identity changed while awaiting post-unpause health"; state=$(docker_command inspect --format '{{.State.Status}}/{{.State.Paused}}/{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$pinned_db_id") || die "cannot inspect post-unpause DB health"; case "$state" in running/false/healthy) return;; running/false/starting|running/false/unhealthy) attempt=$((attempt+1)); sleep 1;; *) die "DB not running and unpaused while awaiting health";; esac; done; die "DB did not become healthy within post-unpause readiness bound"; }
require_db_unpublished(){ pinned_db_id=$1; if ! port_bindings=$(docker_command inspect --format '{{json .HostConfig.PortBindings}}' "$pinned_db_id"); then die "DB port-binding inspection failed"; fi; case "$port_bindings" in '{}'|'null') ;; *) die "DB container has published ports or malformed port-binding inspection";; esac; }
arm(){ id=$1; log=$2; : >"$log"; chmod 0600 "$log"; TOP_DB_WATCHDOG_DOCKER_MODE=$docker_access_mode setsid nohup "$helper" "$id" >"$log" 2>&1 </dev/null & watchdog_pid=$!; i=0; while [ ! -s "$log" ] && [ "$i" -lt 50 ]; do sleep .1; i=$((i+1)); done; [ "$(stat -c %a "$log")" = 600 ] || die "watchdog evidence mode"; first=$(sed -n '1p' "$log"); printf '%s' "$first" | grep -q '"event":"armed"' || die "watchdog not armed"; printf '%s' "$first" | grep -q "\"containerId\":\"$id\"" || die "watchdog ID mismatch"; printf '%s' "$first" | grep -q "\"pid\":$watchdog_pid" || die "watchdog PID mismatch"; printf '%s' "$first" | grep -q "\"dockerAccessMode\":\"$docker_access_mode\"" || die "watchdog Docker access mode mismatch"; kill -0 "$watchdog_pid" || die "watchdog not alive"; ticks=$(printf '%s' "$first" | sed -n 's/.*"procStartTicks":"\([0-9]*\)".*/\1/p'); [ "$(awk '{print $22}' "/proc/$watchdog_pid/stat")" = "$ticks" ] || die "watchdog process identity mismatch"; tr '\000' ' ' <"/proc/$watchdog_pid/cmdline" | grep -Fq "$helper $id" || die "watchdog cmdline mismatch"; [ "$(ps -o sid= -p "$watchdog_pid" | tr -d ' ')" != "$(ps -o sid= -p $$ | tr -d ' ')" ] || die "watchdog is not detached"; armed=$(printf '%s' "$first" | sed -n 's/.*"armedEpoch":\([0-9]*\).*/\1/p'); [ $((armed+45-$(date +%s))) -ge 35 ] || die "insufficient watchdog deadline budget"; [ "$(identity)" = "$id" ] || die "DB identity changed immediately before pause"; }
disarm(){ kill -0 "$watchdog_pid"; kill -TERM "$watchdog_pid"; wait "$watchdog_pid"; tail -n 1 "$log" | grep -q '"event":"disarmed"' || die "watchdog disarm evidence missing"; }
record(){ printf '%s\n' "$1" | app_node rehearsal/db-recovery-continuity.js record-host "$run"; }
create_run_evidence_directory(){ parent=$directory/evidence/db-recovery; mkdir -p -- "$parent"; chmod 0700 "$parent"; mkdir -m 0700 -- "$evidence"; }
command=${1-}; run=${2-}; valid_run "$run"; evidence=$directory/evidence/db-recovery/$run; manifest=$evidence/manifest.json
case "$command" in
 prepare)
  [ "$#" -eq 2 ] || die "usage: db-recovery-host prepare RUN_ID"; services=$(compose config --services); [ "$(printf '%s\n' "$services" | wc -l)" -eq 2 ] && printf '%s\n' "$services" | grep -qx app && printf '%s\n' "$services" | grep -qx db || die "expected exactly app and db"; id=$(identity); require_db_unpublished "$id"; compose port app 3000 | grep -q '^127\.0\.0\.1:' || die "app must be loopback-only"; app_node rehearsal/db-recovery-continuity.js prepare "$run"; record "{\"databaseIdentity\":{\"containerId\":\"$id\"}}"; backup_output=$("$directory/field-test" backup); backup=$(printf '%s\n' "$backup_output" | sed -n 's/^backup created: //p'); [ -f "$backup" ] && [ ! -L "$backup" ] || die "exact backup artifact missing"; sha=$(sha256sum "$backup" | awk '{print $1}'); size=$(stat -c %s "$backup"); marker=$(sed -n '1p' "$backup" | sed 's/"/\\"/g'); record "{\"backupIdentity\":{\"path\":\"$backup\",\"sha256\":\"$sha\",\"size\":\"$size\",\"marker\":\"$marker\"}}"; app_node rehearsal/db-recovery-continuity.js bind-delta "$run";
  id=$(identity); app_node rehearsal/db-recovery-continuity.js assert-db-identity "$run" "$id"; port=$(compose port app 3000 | sed 's/.*://'); app_id=$(app_identity); prove_bounded_verify || die "bounded verify execution is unavailable"; probe_cookie=$(app_node rehearsal/db-recovery-continuity.js probe-cookie "$run"); case "$probe_cookie" in ''|*[!A-Za-z0-9_.=-]*) die "authenticated DB probe session is malformed";; esac; curl -fsS --max-time 3 -H "Cookie: $probe_cookie" "http://127.0.0.1:$port/api/competition?tournamentId=1" >/dev/null || die "authenticated DB-backed read failed before pause"; log=$evidence/watchdog.jsonl; arm "$id" "$log"; docker_command pause "$id" >/dev/null; [ "$(docker_command inspect --format '{{.State.Paused}}' "$id")" = true ] || die "exact DB was not paused"; verify_failed=false; if bounded_verify "$app_id" >/dev/null 2>&1; then die "verify unexpectedly succeeded while DB paused"; else verify_failed=true; fi; app_failed=false; if curl -fsS --max-time 3 -H "Cookie: $probe_cookie" "http://127.0.0.1:$port/api/competition?tournamentId=1" >/dev/null 2>&1; then die "DB-backed read unexpectedly succeeded"; else app_failed=true; fi; docker_command unpause "$id" >/dev/null; require_verify_exec_gone "$app_id"; wait_healthy_exact "$id"; disarm; compose exec -T -e "FAILURE_DB_CONTAINER_ID=$id" -e "FAILURE_DOCKER_ACCESS_MODE=$docker_access_mode" -e FAILURE_PAUSED_EXACT_ID=true -e "FAILURE_VERIFY_FAILED=$verify_failed" -e FAILURE_AUTH_READ_BEFORE=true -e "FAILURE_DB_READ_FAILED=$app_failed" -e FAILURE_UNPAUSE_HEALTHY=true app node rehearsal/db-recovery-continuity.js complete-failure-proof "$run"; app_node rehearsal/db-recovery-continuity.js snapshot "$run" >"$evidence/post-unpause.json"; chmod 0600 "$evidence/post-unpause.json"; printf 'run ID: %s\nbackup path: %s\nbackup SHA-256: %s\nnext action destroys current Modern Field Test data; resume explicitly by run ID\n' "$run" "$backup" "$sha";;
 resume)
  [ "$#" -eq 2 ] || die "usage: db-recovery-host resume RUN_ID"; [ -f "$manifest" ] || die "unknown run ID"; app_node rehearsal/db-recovery-continuity.js assert-restore-gate "$run"; [ "${TOP_FIELD_TEST_DESTRUCTIVE_ACKNOWLEDGEMENT-}" = DESTROY-MODERN-FIELD-TEST-V1-DATA ] || die "existing destructive acknowledgement required"; id=$(identity); health "$id"; app_node rehearsal/db-recovery-continuity.js assert-db-identity "$run" "$id"; backup=$(sed -n 's/.*"path": "\([^"]*\)".*/\1/p' "$manifest" | head -1); expected=$(sed -n 's/.*"sha256": "\([0-9a-f]*\)".*/\1/p' "$manifest" | head -1); [ -f "$backup" ] && [ ! -L "$backup" ] || die "recorded artifact invalid"; [ "$(sha256sum "$backup"|awk '{print $1}')" = "$expected" ] || die "backup hash mismatch"; "$directory/field-test" restore "$backup"; record '{"restoreCompleted":{"existingRestorePath":true},"run":{"id":"'"$run"'","phase":"restored"}}'; app_node rehearsal/db-recovery-continuity.js resume "$run"; "$directory/field-test" verify; app_node rehearsal/db-recovery-continuity.js complete-final-integrity "$run";;
 watchdog-proof-start)
  [ "$#" -eq 2 ] || die "usage: db-recovery-host watchdog-proof-start RUN_ID"; create_run_evidence_directory; app_node rehearsal/db-recovery-continuity.js snapshot "$run" >"$evidence/watchdog-before.json"; chmod 0600 "$evidence/watchdog-before.json"; id=$(identity); printf '%s\n' "$id" >"$evidence/db-container-id"; chmod 0600 "$evidence/db-container-id"; arm "$id" "$evidence/watchdog.jsonl"; docker_command pause "$id" >/dev/null; kill -KILL $$;;
 watchdog-proof-observe)
  [ "$#" -eq 2 ] || die "usage: db-recovery-host watchdog-proof-observe RUN_ID"; id=$(cat "$evidence/db-container-id"); [ "$(identity)" = "$id" ] || die "DB identity changed"; i=0; until health "$id" 2>/dev/null; do sleep 2; i=$((i+1)); [ "$i" -lt 35 ] || die "watchdog did not recover DB"; done; grep -q '"event":"deadline-result".*"result":"unpaused"' "$evidence/watchdog.jsonl" || die "deadline evidence missing"; "$directory/field-test" verify; app_node rehearsal/db-recovery-continuity.js snapshot "$run" >"$evidence/watchdog-after.json"; chmod 0600 "$evidence/watchdog-after.json"; cmp "$evidence/watchdog-before.json" "$evidence/watchdog-after.json" || die "watchdog proof changed DB state";;
 *) die "usage: db-recovery-host prepare|resume|watchdog-proof-start|watchdog-proof-observe RUN_ID";;
esac
