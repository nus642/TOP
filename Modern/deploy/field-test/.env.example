# Copy to .env and replace every placeholder. Never commit the resulting file.
TOP_ENVIRONMENT_ID=modern-field-test-v1-local
TOP_FIELD_TEST_ACKNOWLEDGEMENT=MODERN-FIELD-TEST-V1
# Set only immediately before reset/restore, then remove it again.
TOP_FIELD_TEST_DESTRUCTIVE_ACKNOWLEDGEMENT=
APP_HOST_PORT=3000
# Used only while building the image. Must be the exact 40-hex source commit.
BUILD_ID=replace-with-git-commit
MYSQL_DB=modern_field_test_v1
MYSQL_USER=modern_field_test_v1
MYSQL_PASS=replace-with-unique-random-password
MYSQL_ROOT_PASS=replace-with-a-different-unique-random-password
